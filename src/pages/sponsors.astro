---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OurSponsors from '../components/OurSponsors.astro';
import OrangeFeature from '../components/OrangeFeature.astro';
import ContactForm from '../components/ContactForm.astro';
import TeamOverview from '../components/TeamOverview.astro';
import sponsorship from '../content/sponsors.json';
---
<BaseLayout page="sponsors">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="Sponsors" />
  <main id="main" class="sponsor-page">
    <OrangeFeature title={sponsorship.headline} description={sponsorship.intro} image={sponsorship.image} imageAlt={sponsorship.imageAlt}>
      <div class="hero-actions">
        <a class="button button-swipe button-dark" data-section-link href={withBase(sponsorship.conversationUrl)}>{sponsorship.conversationLabel}<span class="material-icon" aria-hidden="true">chevron_right</span></a>
        <a class="button button-swipe button-dark packet-link" href={withBase(sponsorship.packetUrl)} target="_blank" rel="noreferrer">{sponsorship.packetLabel}<span class="material-icon" aria-hidden="true">open_in_new</span></a>
      </div>
    </OrangeFeature>
    <TeamOverview variant="sponsors" />
    <section class="benefits section-shell" aria-labelledby="benefits-title">
      <header><h2 id="benefits-title">{sponsorship.benefitsTitle}</h2><p>{sponsorship.benefitsIntro} {sponsorship.benefitsPacketBefore} <a href={withBase(sponsorship.packetUrl)} target="_blank" rel="noreferrer">{sponsorship.benefitsPacketLabel}</a> {sponsorship.benefitsPacketAfter}</p></header>
      <div class="benefit-list">{sponsorship.benefits.map((benefit) => <article><span class="benefit-icon material-icon" aria-hidden="true">{benefit.icon}</span><div><h3>{benefit.title}</h3><p>{benefit.description}</p></div></article>)}</div>
    </section>
    <section class="tiers section-shell" id="tiers" aria-labelledby="tiers-title">
      <header><h2 id="tiers-title">{sponsorship.tiersTitle}</h2><p>{sponsorship.tiersIntro}</p></header>
      <div class="tier-grid">{sponsorship.tiers.map((tier) => <article class:list={['tier-card', `tier-${tier.style}`]}>
        <h3><span class="tier-marker" aria-hidden="true"></span>{tier.name}</h3>
        <p class="tier-price">{tier.amount}<span>{sponsorship.tiersPeriod}</span></p>
        <ul>{tier.highlights.map((highlight) => <li><span aria-hidden="true">✓</span>{highlight}</li>)}</ul>
      </article>)}</div>
      <div class="tier-notes"><p>{sponsorship.tiersNote} <a href={withBase(sponsorship.packetUrl)} target="_blank" rel="noreferrer">{sponsorship.benefitsPacketLabel}</a>.</p><p>{sponsorship.tiersSupportNote}</p></div>
      <div class="tier-actions"><a class="button button-swipe button-dark" data-section-link href={withBase(sponsorship.conversationUrl)}>{sponsorship.conversationLabel}<span class="material-icon" aria-hidden="true">chevron_right</span></a></div>
    </section>
    <OurSponsors partners={sponsorship.partners} id="partners" title={sponsorship.partnersTitle} departmentalTitle={sponsorship.departmentalTitle} />
    <section class="connect section-shell" id="connect" aria-labelledby="connect-title">
      <div><h2 id="connect-title">{sponsorship.connectTitle}</h2><p>{sponsorship.connectIntro}</p><a class="button button-swipe button-light packet-link connect-packet" href={withBase(sponsorship.packetUrl)} target="_blank" rel="noreferrer">{sponsorship.packetLabel}<span class="material-icon" aria-hidden="true">open_in_new</span></a></div>
      <ContactForm partnership labels={sponsorship.form} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .benefits { display: flex; flex-direction: column; justify-content: center; }
  .section-shell { padding: 80px clamp(24px, 8vw, 124px); }
  h2 { margin: 0 0 24px; font: 700 clamp(36px, 4.5vw, 58px)/1.05 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  h3 { margin: 0; font: 700 clamp(23px, 2.2vw, 28px)/1.15 var(--display); text-wrap: balance; }
  p { margin: 0; font-size: var(--font-body-min); line-height: 1.65; }
  .eyebrow { margin-bottom: 20px; font-size: var(--font-label-min); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .packet-link { display: inline-flex; min-height: 48px; align-items: center; gap: 10px; font-size: var(--font-ui-min); font-weight: 600; text-decoration: none; }
  .benefits { background: var(--ink); color: var(--paper); }
  .benefits header { margin-bottom: 32px; }
  .benefits header p { max-width: 760px; }
  .benefits header a { text-underline-offset: 4px; }
  .benefit-list { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); column-gap: 48px; }
  .benefit-list article { display: grid; grid-template-columns: 44px minmax(0,1fr); gap: 18px; padding: 28px 0; border-bottom: 1px solid rgba(240,240,240,.2); }
  .benefit-icon { display: grid; place-items: center; width: 40px; height: 32px; color: var(--orange); font-size: 28px; }
  .benefit-list h3 { margin-bottom: 10px; font-size: clamp(22px, 2vw, 26px); }
  .benefit-list p { max-width: 620px; }
  .tiers { background: var(--paper); color: var(--ink); scroll-margin-top: var(--scroll-header-offset); }
  .tiers header { margin-bottom: 40px; }
  .tiers header p { max-width: 700px; }
  .tier-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .tier-card { --tier-accent: #626262; padding: 28px 24px 32px; background: #e3e3e3; clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px); }
  .tier-bronze { --tier-accent: #94552e; background: #ead8c8; }
  .tier-silver { --tier-accent: #5c6b77; background: #dbe0e4; }
  .tier-gold { --tier-accent: #edb849; background: var(--ink); color: var(--paper); }
  .tier-card h3 { display: flex; align-items: center; gap: 10px; font: 700 16px/1.4 var(--display); letter-spacing: .08em; text-transform: uppercase; }
  .tier-marker { width: 9px; height: 9px; transform: rotate(45deg); background: var(--tier-accent); flex-shrink: 0; }
  .tier-price { margin-top: 20px; font: 500 clamp(30px, 3vw, 42px)/1.1 var(--display); letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .tier-price span { display: block; margin-top: 10px; font: 400 14px/1.5 var(--body, sans-serif); letter-spacing: 0; }
  .tier-card ul { display: grid; gap: 14px; padding: 24px 0 0; margin: 24px 0 0; border-top: 1px solid rgba(0,0,0,.18); list-style: none; }
  .tier-gold ul { border-color: rgba(255,255,255,.25); }
  .tier-card li { display: grid; grid-template-columns: 14px 1fr; gap: 10px; font-size: 16px; line-height: 1.55; }
  .tier-card li > span { color: var(--tier-accent); }
  .tier-notes { display: grid; gap: 12px; max-width: 900px; margin: 32px auto 0; text-align: center; }
  .tier-notes p { font-size: 16px; }
  .tier-notes a { text-underline-offset: 4px; }
  .tier-actions { display: flex; justify-content: center; margin-top: 24px; }
  .connect { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; background: var(--ink); color: var(--paper); scroll-margin-top: var(--scroll-header-offset); }
  .connect p { max-width: 560px; }
  .connect-packet { margin-top: 28px; }
  .button-light { background: var(--paper); color: var(--ink); --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .connect :focus-visible { outline-color: var(--orange); }
  @media (max-width: 1100px) { .tier-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 1000px) { .connect { gap: 40px; } .benefit-list { column-gap: 28px; } }
  @media (max-width: 800px) {
    .connect { grid-template-columns: 1fr; }
    .benefit-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {
    .section-shell { padding: 56px 23px; }
    .benefit-list article { gap: 12px; }
    .tier-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) { .sponsor-page > :global(.orange-feature) { min-height: 0; } }
</style>

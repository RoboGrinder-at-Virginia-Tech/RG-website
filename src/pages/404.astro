---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/urls';
import maintenance from '../content/maintenance.json';
---

<BaseLayout page="notFound">
  <meta slot="head" name="robots" content="noindex" />
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="" />
  <main id="main">
    <section class="not-found" aria-labelledby="not-found-title">
      <div class="error-copy">
        <div class="not-found-code" aria-hidden="true">404</div>
        <h1 id="not-found-title">{maintenance.enabled ? maintenance.heading : 'Page not found'}</h1>
        <p>{maintenance.enabled ? maintenance.message : 'We couldn’t find that page. The link may have changed, or the address may have a typo.'}</p>
        <div class="error-actions">
          <a class="button button-swipe button-dark" href={withBase('/')}>Back to home<span class="material-icon" aria-hidden="true">chevron_right</span></a>
          <a class="button button-swipe button-dark" href={withBase('/contact/')}>Contact us<span class="material-icon" aria-hidden="true">chevron_right</span></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .not-found { min-height: calc(100svh - var(--header-height)); display: flex; align-items: center; padding: 72px clamp(24px, 8vw, 124px); background: var(--orange); color: var(--ink); }
  .not-found .not-found-code { position: static; margin-bottom: 24px; color: var(--ink); font-family: var(--display); font-weight: 700; font-size: clamp(200px, 25vw, 360px); line-height: .9; letter-spacing: -.06em; }
  .error-copy { min-width: 0; max-width: 680px; }
  h1 { margin: 0 0 24px; font: 700 clamp(44px, 5vw, 72px)/1.02 var(--display); letter-spacing: -.04em; }
  .error-copy > p { margin: 0 0 32px; font-size: var(--font-body-min); line-height: 1.7; }
  .error-actions { display: flex; flex-wrap: wrap; gap: 16px; }
  .button-dark { --hover-fill: var(--paper); --hover-ink: var(--ink); }
  @media (max-width: 680px) {
    .not-found { padding: 48px 23px; }
    .not-found .not-found-code { font-size: clamp(130px, 36vw, 240px); }
  }
</style>

---
import { withBase } from '../lib/urls';
import frames from '../content/sponsor-artwork-frames.json';
// EDIT CONTENT: partners in sponsors.json supplies both pages.
// EDIT DISPLAY: headings and the homepage call to action are configured here.
const { partners, id = 'supporters', thankYou = '', showCta = false, showDepartmental = true, title = 'Our sponsors', departmentalTitle = 'Departmental supporters' } = Astro.props;
const paperChannels = Array.from({ length: 256 }, (_, value) => Math.min(value, 240) / 255).join(' ');
const sponsors = partners
  .filter((partner) => partner.category !== 'departmental' && partner.logo)
  .sort((first, second) => first.name.localeCompare(second.name, 'en', { sensitivity: 'base' }));
const tierGroups = ['gold', 'silver', 'bronze', 'friend'].map((tier) => ({
  tier,
  title: tier.charAt(0).toUpperCase() + tier.slice(1),
  partners: sponsors.filter((partner) => (partner.tier || 'bronze') === tier),
})).filter((group) => group.partners.length);
const featured = tierGroups.filter((group) => group.tier === 'gold' || group.tier === 'silver');
const other = tierGroups.filter((group) => group.tier === 'bronze' || group.tier === 'friend');
const groups = [
  ...featured,
  {
    tier: 'combined',
    title: featured.length ? other.map((group) => group.title).join(' & ') : '',
    partners: sponsors.filter((partner) => !partner.tier || partner.tier === 'bronze' || partner.tier === 'friend'),
  },
  { tier: 'departmental', title: departmentalTitle, partners: showDepartmental ? partners.filter((partner) => partner.category === 'departmental' && partner.logo) : [] },
].filter((group) => group.partners.length);
const headingId = `${id}-title`;
---
<section class="partners section-shell" id={id} aria-labelledby={headingId}>
  <h2 id={headingId}>{title}</h2>
<svg class="logo-color-definition" width="0" height="0" aria-hidden="true"><defs><filter id="auvsi-paper" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="discrete" tableValues={paperChannels} /><feFuncG type="discrete" tableValues={paperChannels} /><feFuncB type="discrete" tableValues={paperChannels} /></feComponentTransfer></filter></defs></svg>

{groups.map((group) => <div class:list={['sponsor-group', group.tier, ['combined', 'departmental'].includes(group.tier) && 'compact']}>
  {group.title && <h3>{group.title}</h3>}
  <div class="sponsor-logos">
  {group.partners.map((partner) => {
    const linked = group.tier !== 'combined' && partner.linkLogo !== false;
    const LogoTag = linked ? 'a' : 'div';
    const logoAttributes = linked ? {
      href: withBase(partner.url || '/contact/'),
      target: partner.url ? '_blank' : undefined,
      rel: partner.url ? 'noreferrer' : undefined,
      'aria-label': `Visit ${partner.name}`,
      title: partner.name,
    } : { role: 'img', 'aria-label': partner.name };

    return <LogoTag class="sponsor-logo" {...logoAttributes}>
      {frames[partner.logo] && partner.logo !== '/images/partners/sec.png' ? <><svg class="lazy-artwork" viewBox={frames[partner.logo].viewBox} aria-hidden="true" style={`--sponsor-ratio: ${frames[partner.logo].ratio}`}><image href={withBase(partner.logo)} xlink:href={withBase(partner.logo)} width={frames[partner.logo].width} height={frames[partner.logo].height} preserveAspectRatio="xMidYMid meet" /></svg><noscript><img src={withBase(partner.logo)} alt="" loading="lazy" /></noscript></> : <img src={withBase(partner.logo)} alt="" loading="lazy" />}
    </LogoTag>;
  })}
</div>
</div>)}
  {thankYou && <p class="sponsor-thanks">{thankYou}</p>}
  {showCta && <div class="partner-cta">
    <h3>Interested in partnering with us?</h3>
    <a class="button button-swipe button-dark" href={withBase('/sponsors/')}>Sponsor Us<svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
  </div>}
</section>
<style>
  .partners { padding: 112px clamp(24px, 8vw, 124px); background: var(--paper); color: var(--ink); scroll-margin-top: var(--scroll-header-offset); }
  h2 { margin: 0 0 64px; text-align: center; font: 700 clamp(36px, 4.5vw, 58px)/1.05 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  .sponsor-thanks { max-width: 760px; margin: 64px auto 0; text-align: center; font-size: var(--font-body-min); line-height: 1.7; }
  .partner-cta { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; margin-top: 80px; text-align: center; }
  .partner-cta h3 { margin: 0; font: 700 clamp(24px, 2.5vw, 32px)/1.2 var(--display); text-wrap: balance; }
  @media (max-width: 540px) {
    .partners { padding: 72px 23px; }
    h2 { margin-bottom: 48px; }
    .partner-cta { margin-top: 56px; gap: 24px; }
    .sponsor-thanks { margin-top: 48px; }
  }

  .sponsor-logos { --columns: 3; --column-gap: 64px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px var(--column-gap); width: 100%; }
  .sponsor-logo { display: grid; flex: 0 0 calc((100% - (var(--columns) - 1) * var(--column-gap)) / var(--columns)); box-sizing: border-box; place-items: center; min-width: 0; min-height: 160px; padding: 12px; }
  a.sponsor-logo { text-decoration: none; transition: opacity .2s; }
  a.sponsor-logo:hover { opacity: .75; }
  .sponsor-logo img { width: 100%; max-width: 340px; height: 140px; object-fit: contain; }
  .logo-color-definition { position: absolute; pointer-events: none; }
  img[src$="/images/partners/auvsi.png"] { filter: url(#auvsi-paper); }
  .sponsor-logo svg { display: block; width: min(100%, 340px, calc(var(--sponsor-ratio) * 140px)); height: auto; max-height: 140px; aspect-ratio: var(--sponsor-ratio); overflow: hidden; }
  .departmental { margin-top: 40px; padding-top: 32px; }
  .sponsor-group + .sponsor-group { margin-top: 64px; }
  .sponsor-group h3 { margin: 0 0 40px; text-align: center; font: 700 24px/1.2 var(--display); }
  .compact .sponsor-logos { --columns: 5; --column-gap: 24px; row-gap: 24px; }
  .departmental .sponsor-logos { --columns: 6; }
  .compact .sponsor-logo { min-height: 100px; }
  .compact .sponsor-logo img { max-width: 220px; height: 80px; }
  .compact .sponsor-logo svg { width: min(100%, 220px, calc(var(--sponsor-ratio) * 80px)); max-height: 80px; }
  @media (min-width: 768px) and (max-width: 1024px) {
    .sponsor-logos { --columns: 2; }
    .compact .sponsor-logos { --columns: 3; }
  }
  @media (max-width: 767px) {
    .sponsor-logos { --columns: 2; --column-gap: 24px; row-gap: 24px; }
    .gold .sponsor-logos { --columns: 1; }
    .compact .sponsor-logos { --columns: 2; row-gap: 20px; }
  }
  @media (max-width: 680px) {
    .sponsor-logo { min-height: 120px; }
    .compact .sponsor-logo { min-height: 90px; }
    .sponsor-logo img { height: 120px; }
    .sponsor-logo svg { width: min(100%, 340px, calc(var(--sponsor-ratio) * 120px)); max-height: 120px; }
  }
  @media (max-width: 420px) {
    .sponsor-logo img { max-width: 280px; height: 180px; }
    .sponsor-logo svg { width: min(100%, 280px, calc(var(--sponsor-ratio) * 180px)); max-height: 180px; }
  }
</style>

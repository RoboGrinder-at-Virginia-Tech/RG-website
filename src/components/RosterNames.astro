---
import { withBase } from '../lib/urls';
import { compareMembers, leadershipRank, presidencyYear } from '../lib/roster';
type Person = { name: string; subteam: string; role: string; major?: string; photo?: string; portfolio?: string };
const { people, alumni = false } = Astro.props as { people: Person[]; alumni?: boolean };
const order = ['Mechanical', 'Electrical', 'Embedded', 'Software', 'Operations'];
const groups = [
  { name: alumni ? 'Past presidents' : 'Leadership', people: people.filter((person) => person.role && (alumni ? leadershipRank(person.role) === 0 : leadershipRank(person.role) < 4)) },
  ...(alumni ? [{ name: 'Past leadership', people: people.filter((person) => person.role && leadershipRank(person.role) > 0 && leadershipRank(person.role) < 4) }] : []),
  { name: 'Faculty advisors', people: people.filter((person) => leadershipRank(person.role) === 5) },
  ...order.map((name) => ({ name, people: people.filter((person) => leadershipRank(person.role) === 4 && person.subteam === name) })),
  { name: alumni ? 'Other alumni' : 'Other members', people: people.filter((person) => leadershipRank(person.role) === 4 && !person.subteam) },
].filter((group) => group.people.length);
---
<div class="roster-groups">
  {groups.map((group) => <div class:list={{ 'leadership-group': ['Leadership', 'Past presidents', 'Past leadership', 'Faculty advisors'].includes(group.name) }}><h3>{group.name}</h3><ul class:list={{ 'leadership-portraits': ['Leadership', 'Past presidents', 'Past leadership', 'Faculty advisors'].includes(group.name) }}>
    {[...group.people].sort(alumni && group.name === 'Past presidents' ? (a, b) => presidencyYear(b.role) - presidencyYear(a.role) || compareMembers(a, b) : compareMembers).map((person) => <li>{['Leadership', 'Past presidents', 'Past leadership', 'Faculty advisors'].includes(group.name) && (person.photo ? (leadershipRank(person.role) === 5 && person.portfolio ? <a class="advisor-portrait-frame" href={person.portfolio} aria-label={`View ${person.name}'s department profile`}><img src={withBase(person.photo)} alt={`Portrait of ${person.name}`} width="320" height="400" loading="lazy" /></a> : <img class="leader-portrait" src={withBase(person.photo)} alt={`Portrait of ${person.name}`} width="320" height="400" loading="lazy" />) : <div class="leader-placeholder" role="img" aria-label={`Photo pending for ${person.name}`}><img src={withBase('/images/rg-gray-square.png')} alt="" width="1080" height="1080" loading="lazy" /></div>)}{leadershipRank(person.role) === 5 && person.portfolio ? <a class="advisor-profile" href={person.portfolio}>{person.name}</a> : person.name}{person.role && <span>{leadershipRank(person.role) === 5 ? person.role.replace(/^Faculty Advisor,\s*/i, '') : person.role}</span>}</li>)}
  </ul></div>)}
</div>
<style>
  .roster-groups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; padding: 20px 0 36px; }
  .leadership-group { grid-column: 1 / -1; }
  .leadership-portraits { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px 24px; }
  .leader-portrait, .leader-placeholder { width: 100%; aspect-ratio: 4 / 5; margin-bottom: 16px; background: #e0e0e0; clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px); }
  .leader-portrait { height: auto; object-fit: cover; }
  .leader-placeholder { display: grid; place-items: center; }
  .leader-placeholder img { width: 50%; height: auto; }
  @media (max-width: 1100px) { .leadership-portraits { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .leadership-portraits { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; } }
  .advisor-profile { color: inherit; text-decoration: none; transition: color 220ms ease; }
  .advisor-profile:hover, .advisor-profile:focus-visible { color: var(--orange); }
  h3 { font: 700 20px/1.4 var(--display); margin: 0 0 16px; }
  ul { padding: 0; margin: 0; list-style: none; }
  li { padding: 5px 0; font-size: var(--font-body-min); line-height: 1.6; overflow-wrap: anywhere; }
  li span { display: block; font-size: var(--font-label-min); color: var(--muted-ink); }
  @media (max-width: 1100px) { .roster-groups { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .roster-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  @media (max-width: 440px) { .roster-groups { grid-template-columns: 1fr; } }
  .advisor-portrait-frame { display: block; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; margin-bottom: 16px; background: #e0e0e0; clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px); }
  .advisor-portrait-frame img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 220ms ease; }
  .advisor-portrait-frame:focus-visible img { transform: scale(1.06) translateY(-3px); }
  li:focus-within > .advisor-profile { color: var(--orange); }
  @media (hover: hover) and (pointer: fine) {
    li:hover > .advisor-portrait-frame img { transform: scale(1.06) translateY(-3px); }
    li:hover > .advisor-profile { color: var(--orange); }
  }
  @media (prefers-reduced-motion: reduce) {
    .advisor-portrait-frame img { transition: none; }
    li:hover > .advisor-portrait-frame img, .advisor-portrait-frame:focus-visible img { transform: none; }
  }
</style>

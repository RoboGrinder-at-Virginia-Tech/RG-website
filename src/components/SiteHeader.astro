---
import { withBase } from '../lib/urls';
import site from '../content/site.json';
import { primaryAction } from '../lib/season';
import ConnectSocialLinks from './ConnectSocialLinks.astro';
const { active = 'Home' } = Astro.props;
const gobblerConnect = site.links.social.find((link) => link.name === 'GobblerConnect');
const links = [
  { label: 'Achievements', href: '/#achievements', active: 'Achievements' },
  { label: 'Our Subteams', href: '/#subteams', active: 'Home' },
  { label: 'Our Robots', href: '/robots/', active: 'Robots' },
  { label: 'Members', href: '/members/', active: 'Members' },
  { label: 'Gallery', href: '/gallery/', active: 'Gallery' },
  { label: 'Sponsor Us', href: '/sponsors/', active: 'Sponsors' },
  { label: 'Contact Us', href: '/contact/', active: 'Contact' },
];
---

<div class="header-shell">
  <header class="site-header">
    <a class="brand" href={withBase('/')} aria-label="RoboGrinder home">
      <img src={withBase('/images/rg-white-small.png')} alt="" loading="lazy" />
    </a>
    <div class="header-controls">
    <button class="mobile-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-navigation"><span class="material-icon" aria-hidden="true">menu</span></button>
    <details class="mobile-menu primary-menu" data-disclosure>
      <summary aria-label="Open About Us menu"><span class="primary-label">About Us</span><span class="material-icon dropdown-arrow" aria-hidden="true">expand_more</span><span class="material-icon burger-icon" aria-hidden="true">menu</span><span class="material-icon burger-close" aria-hidden="true">close</span></summary>
      <nav aria-label="Main navigation">
        {links.filter((link) => !['Sponsors', 'Contact'].includes(link.active)).map((link) => <a href={withBase(link.href)} aria-current={active === link.active && link.active !== 'Home' ? 'page' : undefined}>{link.label}<span class="material-icon" aria-hidden="true">chevron_right</span></a>)}
      </nav>
    </details>
    <details class="mobile-menu support-menu" data-disclosure>
      <summary aria-label="Open Connect menu">Connect<span class="material-icon dropdown-arrow" aria-hidden="true">expand_more</span></summary>
      <nav aria-label="Connect">
        {primaryAction.page !== 'Join' && <a href={withBase(site.recruitment.joinUrl)} aria-current={active === 'Join' ? 'page' : undefined}>{site.recruitment.joinLabel}<span class="material-icon" aria-hidden="true">chevron_right</span></a>}
        {primaryAction.page !== 'Sponsors' && <a href={withBase('/sponsors/')} aria-current={active === 'Sponsors' ? 'page' : undefined}>Sponsor Us<span class="material-icon" aria-hidden="true">chevron_right</span></a>}
        <a href={withBase('/contact/')} aria-current={active === 'Contact' ? 'page' : undefined}>Contact Us<span class="material-icon" aria-hidden="true">chevron_right</span></a>
        {gobblerConnect && <a href={withBase(gobblerConnect.url)} target="_blank" rel="noreferrer">GobblerConnect<span class="material-icon" aria-hidden="true">chevron_right</span></a>}
        <ConnectSocialLinks showCommunity={false} />
      </nav>
    </details>
    <a class="header-cta button-swipe" href={withBase(primaryAction.href)} aria-current={active === primaryAction.page ? 'page' : undefined}>{primaryAction.label}<svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
    </div>
  </header>
  <nav class="mobile-navigation" id="mobile-navigation" aria-label="Mobile navigation" hidden>
    <div class="mobile-view" data-mobile-view="main">
      <div class="mobile-view-links">
        {links.filter((link) => link.active !== 'Sponsors').map((link) => <a href={withBase(link.href)} aria-current={active === link.active && link.active !== 'Home' ? 'page' : undefined}>{link.label}<span class="material-icon" aria-hidden="true">chevron_right</span></a>)}
        <ConnectSocialLinks showSocials={false} />
      </div>
      <div class="mobile-view-actions">
        <div class="mobile-socials"><ConnectSocialLinks showCommunity={false} /></div>
        <a href={withBase(site.recruitment.joinUrl)}>{site.recruitment.joinLabel}<svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
        <a class="mobile-primary-action button-swipe" href={withBase('/sponsors/')}>Sponsor Us<svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
      </div>
    </div>
  </nav>
</div>

<script>
  const brandLink = document.querySelector<HTMLAnchorElement>('.site-header .brand');
  brandLink?.addEventListener('click', (event) => {
    if (location.pathname.replace(/\/$/, '') === new URL(brandLink.href).pathname.replace(/\/$/, '')) {
      event.preventDefault();
    }
  });
  const disclosures = new Map<HTMLDetailsElement, (open: boolean) => void>();
  const narrowScreen = matchMedia('(max-width: 1024px)');
  const menuShell = document.querySelector<HTMLElement>('.header-shell');
  const mobileToggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle')!;
  const mobileNavigation = document.querySelector<HTMLElement>('.mobile-navigation')!;
  let mobileOpen = false;
  const backgroundInert = new Map<HTMLElement, boolean>();
  let mobileAnimation: Animation | undefined;
  const setMobileOpen = (open: boolean, restoreFocus = true) => {
    mobileOpen = open;
    mobileAnimation?.cancel();
    mobileNavigation.hidden = false;
    mobileNavigation.inert = !open;
    const swipe = mobileNavigation.animate(
      open ? [{ clipPath: 'inset(0 0 0 100%)' }, { clipPath: 'inset(0 0 0 0)' }]
        : [{ clipPath: 'inset(0 0 0 0)' }, { clipPath: 'inset(0 0 0 100%)' }],
      { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 250, easing: 'ease', fill: 'both' }
    );
    mobileAnimation = swipe;
    swipe.onfinish = () => {
      if (mobileAnimation !== swipe) return;
      mobileNavigation.hidden = !open;
      swipe.cancel();
      mobileAnimation = undefined;
    };
    mobileToggle.setAttribute('aria-expanded', String(open));
    mobileToggle.setAttribute('aria-label', `${open ? 'Close' : 'Open'} navigation menu`);
    mobileToggle.querySelector('.material-icon')!.textContent = open ? 'close' : 'menu';
    document.documentElement.classList.toggle('mobile-navigation-open', open);
    if (open) {
      document.querySelectorAll<HTMLElement>('main, footer').forEach((element) => { backgroundInert.set(element, element.inert); element.inert = true; });
      mobileNavigation.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    } else {
      backgroundInert.forEach((wasInert, element) => { element.inert = wasInert; });
      backgroundInert.clear();
      if (restoreFocus) mobileToggle.focus({ preventScroll: true });
    }
  };
  mobileToggle.addEventListener('click', () => setMobileOpen(!mobileOpen));
  mobileNavigation.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', () => setMobileOpen(false, false)));
  menuShell?.addEventListener('keydown', (event) => {
    if (!mobileOpen) return;
    if (event.key === 'Escape') { event.preventDefault(); setMobileOpen(false); }
    if (event.key === 'Tab') {
      const focusable = [...menuShell.querySelectorAll<HTMLElement>('a[href], button, summary')].filter((element) => element.getClientRects().length && !element.closest('[inert]'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
  const syncMenuHeight = () => {
    const openMenu = document.querySelector<HTMLElement>('.mobile-menu > summary[aria-expanded="true"]')?.parentElement;
    const panel = openMenu?.querySelector<HTMLElement>('nav');
    menuShell?.style.setProperty('--menu-height', !narrowScreen.matches && panel ? `${panel.scrollHeight}px` : '0px');
    menuShell?.classList.toggle('menu-expanded', Boolean(openMenu));
  };
  const menuSize = new ResizeObserver(syncMenuHeight);
  document.querySelectorAll<HTMLElement>('.mobile-menu nav').forEach((panel) => menuSize.observe(panel));
  const updateMenuLabel = () => {
    const summary = document.querySelector<HTMLElement>('.primary-menu > summary');
    if (summary) summary.setAttribute('aria-label', `${summary.getAttribute('aria-expanded') === 'true' ? 'Close' : 'Open'} ${narrowScreen.matches ? 'navigation' : 'About Us'} menu`);
  };
  narrowScreen.addEventListener('change', updateMenuLabel);
  updateMenuLabel();
  document.querySelectorAll<HTMLDetailsElement>('[data-disclosure]').forEach((details) => {
    const summary = details.querySelector<HTMLElement>(':scope > summary')!;
    const panel = details.querySelector<HTMLElement>(':scope > nav, :scope > .disclosure-panel')!;
    let animation: Animation | undefined;
    let contentAnimation: Animation | undefined;
    let expanded = details.open;
    summary.setAttribute('aria-expanded', String(expanded));
    const setExpanded = (open: boolean) => {
      if (expanded === open) return;
      const menu = details.classList.contains('mobile-menu');
      const currentHeight = menu ? panel.getBoundingClientRect().height : details.getBoundingClientRect().height;
      const renderedOpacity = Number.parseFloat(getComputedStyle(panel).opacity);
      const currentOpacity = animation || contentAnimation || expanded ? renderedOpacity : 0;
      const currentClip = getComputedStyle(panel).clipPath;
      expanded = open;
      animation?.cancel();
      contentAnimation?.cancel();
      summary.setAttribute('aria-expanded', String(open));
      if (details.classList.contains('mobile-menu')) {
        const label = details.classList.contains('support-menu') ? 'Connect' : narrowScreen.matches ? 'navigation' : 'About Us';
        summary.setAttribute('aria-label', `${open ? 'Close' : 'Open'} ${label} menu`);
        if (open) disclosures.forEach((set, other) => { if (other !== details && other.classList.contains('mobile-menu')) set(false); });
      }
      details.open = true;
      if (menu) {
        panel.inert = !open;
        syncMenuHeight();
      }
      if (menu) {
        panel.style.overflow = 'hidden';
        const frames = open
          ? [{ clipPath: currentClip === 'none' ? 'inset(0 0 100% 0)' : currentClip }, { clipPath: 'inset(0 0 0 0)' }]
          : [{ clipPath: currentClip === 'none' ? 'inset(0 0 0 0)' : currentClip }, { clipPath: 'inset(0 0 100% 0)' }];
        animation = panel.animate(frames, { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 250, easing: 'ease', fill: 'both' });
      } else {
        details.style.overflow = 'hidden';
        details.style.removeProperty('height');
        const expandedHeight = details.getBoundingClientRect().height;
        const borders = Number.parseFloat(getComputedStyle(details).borderTopWidth) + Number.parseFloat(getComputedStyle(details).borderBottomWidth);
        const collapsedHeight = summary.getBoundingClientRect().height + borders;
        details.style.height = `${currentHeight}px`;
        const frames = open
          ? [{ height: `${currentHeight}px` }, { height: `${expandedHeight}px` }]
          : [{ height: `${currentHeight}px` }, { height: `${collapsedHeight}px` }];
        animation = details.animate(frames, { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 500, easing: 'ease-in-out', fill: 'both' });
        panel.style.opacity = String(Number.isFinite(currentOpacity) ? currentOpacity : open ? 0 : 1);
        contentAnimation = panel.animate(
          [{ opacity: Number.isFinite(currentOpacity) ? currentOpacity : open ? 0 : 1 }, { opacity: open ? 1 : 0 }],
          { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 500, easing: 'ease-in-out', fill: 'both' }
        );
      }
      const current = animation;
      animation.onfinish = () => {
        if (animation === current) {
          details.open = open;
          current.cancel();
          contentAnimation?.cancel();
          contentAnimation = undefined;
          details.style.removeProperty('height');
          details.style.removeProperty('overflow');
          panel.style.removeProperty('opacity');
          panel.style.removeProperty('transform');
          panel.style.removeProperty('overflow');
          animation = undefined;
        }
      };
    };
    disclosures.set(details, setExpanded);
    summary.addEventListener('click', (event) => { event.preventDefault(); setExpanded(!expanded); });
  });
  narrowScreen.addEventListener('change', () => {
    if (mobileOpen) setMobileOpen(false, false);
    disclosures.forEach((set, details) => { if (details.classList.contains('mobile-menu')) set(false); });
    syncMenuHeight();
  });
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
    document.addEventListener('click', (event) => { if (!menu.contains(event.target as Node)) disclosures.get(menu)?.(false); });
    menu.addEventListener('keydown', (event) => { if (event.key === 'Escape') { disclosures.get(menu)?.(false); menu.querySelector('summary')?.focus(); } });
  });
  document.querySelectorAll<HTMLAnchorElement>('.mobile-menu nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const menu = link.closest<HTMLDetailsElement>('details');
      if (menu) disclosures.get(menu)?.(false);
    });
  });
  const headerShell = document.querySelector<HTMLElement>('.header-shell');
  const videoHero = document.querySelector<HTMLElement>('.landing');
  if (headerShell) {
    let previousY = Math.max(0, window.scrollY);
    const heroBottom = () => videoHero ? videoHero.getBoundingClientRect().bottom + window.scrollY : 0;
    let hidden = !location.hash && previousY > 0 && (!videoHero || previousY >= heroBottom() - headerShell.offsetHeight);
    let navigatingToSection = false;
    let navigationTimeout: ReturnType<typeof setTimeout> | undefined;
    const updateHeader = () => {
      headerShell.classList.toggle('header-hidden', hidden);
      document.documentElement.classList.toggle('header-is-hidden', hidden);
    };
    updateHeader();
    // Keep anchor offsets accurate after breakpoint or layout changes.
    const measureHeader = () => {
      document.documentElement.style.setProperty('--measured-header-height', `${headerShell.offsetHeight}px`);
    };
    measureHeader();
    const headerSize = new ResizeObserver(measureHeader);
    headerSize.observe(headerShell);
    const resumeUserScroll = () => {
      navigatingToSection = false;
      clearTimeout(navigationTimeout);
      previousY = Math.max(0, window.scrollY);
    };
    headerShell.addEventListener('focusin', () => {
      hidden = false;
      updateHeader();
    });
    const navigateToSection = (hash: string, moveFocus = false) => {
      let target: HTMLElement | null;
      try { target = document.getElementById(decodeURIComponent(hash.slice(1))); } catch { return false; }
      if (!target) return false;
      // Hold the navbar visible during the jump so its offset cannot change
      // halfway through smooth scrolling, whether moving up or down the page.
      navigatingToSection = true;
      hidden = false;
      updateHeader();
      measureHeader();
      if (moveFocus) {
        const hadTabindex = target.hasAttribute('tabindex');
        if (!hadTabindex) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        if (!hadTabindex) target.addEventListener('blur', () => target?.removeAttribute('tabindex'), { once: true });
      }
      target.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      clearTimeout(navigationTimeout);
      navigationTimeout = setTimeout(resumeUserScroll, 2000);
      return true;
    };
    document.querySelectorAll<HTMLAnchorElement>('.mobile-menu nav a, .mobile-navigation a, a[data-section-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const destination = new URL(link.href);
        if (destination.origin !== location.origin || destination.pathname !== location.pathname || !destination.hash) return;
        if (navigateToSection(destination.hash, true)) {
          event.preventDefault();
          history.pushState(null, '', destination.href);
        }
      });
    });
    window.addEventListener('scrollend', () => { if (navigatingToSection) resumeUserScroll(); });
    window.addEventListener('hashchange', () => { if (location.hash) navigateToSection(location.hash); });
    if (location.hash) requestAnimationFrame(() => navigateToSection(location.hash));
    window.addEventListener('wheel', resumeUserScroll, { passive: true });
    window.addEventListener('touchmove', resumeUserScroll, { passive: true });
    window.addEventListener('keydown', (event) => {
      if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) resumeUserScroll();
    });
    window.addEventListener('scroll', () => {
      const currentY = Math.max(0, window.scrollY);
      const delta = currentY - previousY;
      if (mobileOpen) { hidden = false; updateHeader(); previousY = currentY; return; }
      if (navigatingToSection) { previousY = currentY; return; }
      if (currentY <= 0 || delta < 0 || headerShell.querySelector(':focus-visible')) {
        hidden = false;
      } else if (delta > 0 && (!videoHero || currentY >= heroBottom() - headerShell.offsetHeight)) {
        hidden = true;
      }
      if (hidden) {
        document.querySelectorAll<HTMLDetailsElement>('.mobile-menu[open]').forEach((menu) => disclosures.get(menu)?.(false));
      }
      updateHeader();
      previousY = currentY;
    }, { passive: true });
  }
</script>

<style>
  .header-shell { position: sticky; top: 0; z-index: 20; background: #000000; transition: transform 240ms ease; }
  .header-shell.header-hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .header-shell { transition: none; } }
  .site-header { position: relative; height: var(--header-height); display: flex; align-items: center; gap: 28px; justify-content: space-between; padding: 0 clamp(24px, 6vw, 92px); background: #000000; color: var(--paper); }
  .brand { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; gap: 12px; color: var(--paper); text-decoration: none; flex: 0 0 auto; }
  .brand img { width: 36px; height: 36px; object-fit: contain; }
  .header-controls { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .mobile-nav-toggle, .mobile-navigation { display: none; }
  .header-cta { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 18px; background: var(--orange); color: #fff; --hover-fill: #fff; --hover-ink: var(--ink); font-size: var(--font-ui-min); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .mobile-menu { position: relative; display: block; }
  .mobile-menu summary { min-width: 44px; height: 44px; padding: 0 16px; display: flex; gap: 10px; align-items: center; justify-content: center; list-style: none; cursor: pointer; color: var(--paper); font-size: var(--font-ui-min); font-weight: 600; white-space: nowrap; }
  .burger-icon, .burger-close { display: none; }
  .dropdown-arrow { transition: rotate 300ms ease; }
  .mobile-menu summary { transition: color 200ms ease; }
  @media (hover: hover) and (pointer: fine) { .mobile-menu summary:hover { color: var(--orange); } }
  [aria-expanded="true"] .dropdown-arrow { rotate: 180deg; }
  .mobile-menu .menu-close { display: none; }
  .mobile-menu[open] .menu-open { display: none; }
  .mobile-menu[open] .menu-close { display: inline-block; }
  .mobile-menu nav a[aria-current="page"] { color: var(--orange); }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu { --menu-dropdown-offset: calc((var(--header-height) - 44px) / 2); }
  .mobile-menu nav { position: absolute; top: calc(100% + var(--menu-dropdown-offset)); right: 0; width: min(320px, calc(100vw - 32px)); padding: 0 20px; overflow: hidden; background: #000; border: 0; }
  .mobile-menu nav a { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--menu-link-color, var(--paper)); font-size: var(--font-ui-min); text-decoration: none; }
  .mobile-menu nav a:last-child { border-bottom: 0; }
  @media (max-width: 1024px) {
    :global(html.mobile-navigation-open) { overflow: hidden; }
    .mobile-nav-toggle { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; background: none; border: 0; color: var(--paper); cursor: pointer; }
    .mobile-nav-toggle .material-icon { font-size: 28px; }
    .mobile-navigation:not([hidden]) { display: block; position: absolute; top: 100%; left: 0; width: 100%; height: calc(100dvh - var(--header-height)); overflow: hidden; background: #000; color: var(--paper); }
    .mobile-view { --mobile-link-padding: 16px; position: absolute; inset: 0; display: flex; flex-direction: column; gap: 20px; padding: 20px 24px; overflow-y: auto; overscroll-behavior: contain; transition: transform 300ms ease-in-out; }
    .mobile-view-links { display: grid; }
    .mobile-view-links a, .mobile-view-links button, .mobile-view-actions > a { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; color: inherit; text-decoration: none; font: 600 20px/1.3 var(--display); text-align: left; background: none; border: 0; padding: 10px var(--mobile-link-padding); cursor: pointer; }
    .mobile-view-links a[aria-current="page"] { color: var(--orange); }
    .mobile-view-actions { display: grid; gap: 12px; margin-top: auto; padding-bottom: env(safe-area-inset-bottom); }
    .mobile-view-actions > a { padding: 16px var(--mobile-link-padding); background: var(--ink); font-size: 18px; border: 0; }
    .mobile-socials { padding-inline: 5px; }
    .mobile-view-actions .mobile-primary-action { background: var(--orange); color: #fff; --hover-fill: var(--paper); --hover-ink: var(--ink); clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%); }
    @media (hover: hover) and (pointer: fine) {
      .mobile-view-links a:hover, .mobile-view-actions a:not(.mobile-primary-action):hover, .mobile-nav-toggle:hover { color: var(--orange); }
      .mobile-view-actions .mobile-primary-action:hover { color: var(--hover-ink); }
    }
    .site-header { padding: 0 24px; gap: 12px; }
    .mobile-menu { display: none; }
    .mobile-menu nav { width: min(420px, calc(100vw - 2 * var(--mobile-gutter, 24px))); max-height: calc(100dvh - var(--header-height) - 20px); overflow-y: auto; }
    .mobile-menu summary { min-width: 44px; height: 44px; padding: 0; }
    .support-menu, .header-cta, .brand-copy, .primary-label, .primary-menu .dropdown-arrow { display: none; }
    .primary-menu .burger-icon { display: inline-block; }
    .primary-menu summary[aria-expanded="true"] .burger-icon { display: none; }
    .primary-menu summary[aria-expanded="true"] .burger-close { display: inline-block; }
    .mobile-menu summary .material-icon { font-size: 23px; }
  }
  @media (max-width: 1024px) and (min-width: 521px) {
    .mobile-view { padding: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .mobile-view { transition: none; } }
  @media (min-width: 1025px) {
    .mobile-menu { position: static; }
    .mobile-menu nav { z-index: 1; top: 100%; left: 0; right: 0; width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 280px)); grid-template-rows: repeat(3, auto); grid-auto-flow: column; justify-content: start; align-items: start; column-gap: 40px; padding: 12px var(--desktop-gutter, clamp(24px, 6vw, 92px)) 20px; max-height: calc(100dvh - var(--header-height)); overflow-y: auto; background: #000; border: 0; }
    .support-menu nav { grid-template-columns: minmax(0, 280px) minmax(0, 1fr) minmax(0, 308px); }
    .support-menu nav :global(.connect-extras) { grid-column: 3; grid-row: 1 / span 3; justify-self: end; width: 100%; padding-top: 0; }
    .mobile-menu summary[aria-expanded="true"] { color: var(--orange); }
    .brand img { width: 32px; height: 32px; }
    .site-header { --font-ui-min: 14px; }
  }
  @media (max-width: 360px) {
    .mobile-menu summary { gap: 4px; }
  }
  @media (max-width: 520px) {
    .site-header { padding: 0 24px; }
    .brand { gap: 8px; }
    .brand img { width: 35px; height: 35px; }
  }
</style>
